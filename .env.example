# 세션 암호화 키 (필수, 32자 이상). 임의 문자열을 생성해 사용
SESSION_PASSWORD=change-me-to-a-long-random-string-of-at-least-32-chars

# Google 서비스 계정 (Sheets + Drive 공통 인증)
# stepup2@iiam.co.kr 로의 도메인 위임 필요
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_DELEGATED_USER=stepup2@iiam.co.kr

# 일일현황 구글 스프레드시트 ID (URL의 /d/{ID}/ 부분)
DAILY_SHEETS_SPREADSHEET_ID=

# 경비 관리 구글 스프레드시트 ID
EXPENSE_SHEETS_SPREADSHEET_ID=

# 영수증 업로드 루트 폴더 ID (구글 드라이브의 "2026 성장농" 폴더)
DRIVE_ROOT_FOLDER_ID=

# IMAP (Gmail 사용 시 앱 비밀번호 발급 필요)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=stepup2@iiam.co.kr
IMAP_PASSWORD=

# OCR (선택). Google Cloud Vision API 키 JSON 경로
GOOGLE_VISION_KEY_PATH=

# 폴링 활성화 (true 시 5분 간격 cron 실행)
ENABLE_SCHEDULER=false

# ── 세션 (필수, 32자 이상 임의 문자열) ──
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=change-me-to-a-long-random-string-of-at-least-32-chars

# ── Turso (Vercel 운영 시 필수) ──
# 로컬 개발에서는 비워두면 file:./data/app.db 사용
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Vercel Cron 보호용 시크릿 (운영 필수) ──
# Vercel Cron이 보내는 Authorization: Bearer <CRON_SECRET> 검증에 사용
CRON_SECRET=

# ── Google 서비스 계정 (Sheets + Drive + Gmail 공통) ──
# JSON 전체를 한 줄 문자열로 환경변수에 넣음 (Vercel은 파일경로 불가)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DELEGATED_USER=stepup2@iiam.co.kr

# ── Sheets / Drive ──
DAILY_SHEETS_SPREADSHEET_ID=
EXPENSE_SHEETS_SPREADSHEET_ID=
DRIVE_ROOT_FOLDER_ID=

# ── Gmail (서비스 계정 도메인 위임 사용) ──
GMAIL_USER=stepup2@iiam.co.kr

# ── 레거시 IMAP (Vercel 미지원, 로컬 개발용) ──
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# ── 로컬 in-process 스케줄러 (Vercel에서는 무시되고 Vercel Cron 사용) ──
ENABLE_SCHEDULER=false

    { "path": "/api/integrations/mail/sync?includeRead=1&sinceDays=14", "schedule": "0 7 * * *" },
    { "path": "/api/integrations/mail/sync?includeRead=1&sinceDays=14", "schedule": "0 12 * * *" },
    { "path": "/api/reports/weekly/auto", "schedule": "0 11 * * 4" }
